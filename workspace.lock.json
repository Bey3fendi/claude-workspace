      "enabled": true
    },
    {
      "name": "ponytail",
      "description": "DietrichGebert/ponytail 5.3.3 (pinned)",
      "upstreamVersion": "5.3.3",
      "source": { "source": "url", "url": "https://github.com/DietrichGebert/ponytail.git", "sha": "96608e078b2d5ea607c5c3b8b5a54d1c1fba6846" },
      "enabled": true
    },
    {
      "name": "andrej-karpathy-skills",
      "description": "multica-ai/andrej-karpathy-skills 1.0.0 (pinned)",
      "upstreamVersion": "1.0.0",
      "source": { "source": "url", "url": "https://github.com/multica-ai/andrej-karpathy-skills.git", "sha": "2c606141936f1eeef17fa3043a72095b4765b9c2" },
      "enabled": true
