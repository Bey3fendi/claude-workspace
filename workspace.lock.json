{
  "schema": 1,
  "workspaceVersion": "0.9.0",
  "marketplace": {
    "name": "cw-workspace",
    "owner": "claude-workspace",
    "description": "Portable Claude Code workspace: upstream plugins pinned by commit SHA plus workspace-core"
  },
  "claudeCode": { "min": "2.1.290", "tested": ["2.1.316", "2.1.317"] },
