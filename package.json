{
  "name": "claude-workspace",
  "version": "0.12.0",
  "description": "Portable, pinned Claude Code workspace: Superpowers, Ponytail, a default CLAUDE.md with the Karpathy guidelines, file-based md-memory, optional router, truthful Workspace Usage reporting",
  "type": "module",
  "bin": { "claude-workspace": "cli/bin/claude-workspace.mjs" },
  "engines": { "node": ">=22.13.0" },
  "files": ["LICENSE", "cli/", "observability/", "plugins/", "policies/", "templates/", "vendor/", ".claude-plugin/", "workspace.lock.json", "scripts/"],
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "gen:marketplace": "node scripts/gen-marketplace.mjs",
    "check:marketplace": "node scripts/gen-marketplace.mjs --check",
    "build:feature": "node scripts/build-feature.mjs"
  },
  "repository": { "type": "git", "url": "git+https://github.com/Bey3fendi/claude-workspace.git" },
  "license": "MIT"
}
